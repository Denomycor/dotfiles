(deflisten wifi "./scripts/wifi.sh")
(deflisten time "./scripts/time.sh")
(deflisten battery "./scripts/battery.sh")
(deflisten audio "./scripts/audio.sh")
(deflisten power_profile "./scripts/power_profile.sh")
(deflisten brightness "./scripts/brightness.sh")
(deflisten workspaces_monitor0 "./scripts/workspaces.sh 0")
(deflisten workspaces_monitor1 "./scripts/workspaces.sh 1")
(deflisten notifications :initial "[]" "./scripts/notification_daemon.py")

(defwindow bar
    :monitor '["<primary>", 0]'
    :class "bar"
    :geometry (geometry :x "0%"
        :y "10px"
        :width "98%"
        :height "30px"
        :anchor "top center")
        :exclusive true
    :stacking "fg"
    (bar)
)

(defwindow notifications
    :monitor '["<primary>", 0]'
    :class "notifications_window"
    :geometry (geometry :x "0%"
        :y "50px"
        :width "300px"
        :height "1px"
        :anchor "top right")
    :exclusive false
    :focusable false
    :stacking "overlay"
    (notification_popups)
)

;; containers

(defwidget bar []
    (centerbox :orientation "h"
        (workspaces :monitor 0)
        (box)
        (right_widgets)
    )
)

(defwidget workspaces [monitor]
    (box :class "workspaces" :orientation "h" :space-evenly false :halign "start"
        (for workspace in {monitor == 0 ? workspaces_monitor0 : workspaces_monitor1}
            (button :class "ws_button ${workspace.active ? (workspace.focused ? "workspace-active-focused" : "workspace-active-unfocused") : "workspace-inactive"}"
                :onclick "hyprctl dispatch workspace ${workspace.id}"
                "${workspace.id}"
            )
        )
    )
)


(defwidget right_widgets []
    (box :class "right_widgets" :orientation "h" :halign "end" :space-evenly false
        (info_box :classo "battery_box"
            (icon_box :classo "" {battery.state == "charging" ? "󰂄" : battery.charge < "80" ? battery.charge < "30" ? "󰁻":"󰁾":"󰁹"})
            (hspacer :space 8)
            "${battery.charge}%"
        )
        (info_box :classo "brightness_box"
            (icon_box :classo "" {brightness < "33" ? "󰃞" : brightness < "66" ? "󰃟" : "󰃠"})
            (hspacer :space 8)
            "${brightness}%"
        )
        (info_box :classo "power_box"
            (icon_box :classo "" {power_profile == "power-saver" ? "󰌪" : power_profile == "performance" ? "󰓅" : "󰾉"})
            (hspacer :space 8)
            {power_profile == "power-saver" ? "Saver" : power_profile == "performance" ? "Perf" : "Balanced"}
        )
        (info_box :classo "wifi_box"
            (icon_box :classo "" {wifi.ssid == "" ? "󰤫":"󰤨"})
            (hspacer :space 10)
            "${wifi.ssid} (${wifi.signal}%)"
        )
        (info_box :classo "audio_box" 
            (icon_box :classo "" {audio.muted ? "󰝟" : audio.volume < "50" ? audio.volume < "1" ? "󰝟" : "󰖀" : "󰕾"})
            (hspacer :space 8)
            {audio.muted ? "Off" : "${audio.volume}%"}
        )
        (info_box :classo "clock_box" 
            (icon_box :classo "" "󰥔")
            (hspacer :space 8)
            time
        )
    )
)


(defwidget notification_popups []
    (box :class "notification_popups" :orientation "v" :space-evenly false :halign "end" :valign "start"
        (for notif in notifications
            (box :class "notification" :orientation "h" :space-evenly false
                (image :class "notification-icon" :path {notif.icon} :image-width 40 :image-height 40 :visible {notif.icon != ""})
                (box :orientation "v" :space-evenly false :halign "start" :hexpand true
                    (label :class "notification-title" :halign "start" :limit-width 30 :text {notif.summary})
                    (label :class "notification-body" :halign "start" :wrap true :text {notif.body})
                )
            )
        )
    )
)

;; building blocks

(defwidget icon_box [classo] 
    (box :class "icon_box ${classo}"
        (children)
    )
)

(defwidget info_box [classo]
    (box :class "info_box ${classo}" :space-evenly false
        (children)
    )
)

(defwidget hspacer [space]
    (box :class "spacer" :width space)
)

;; 󰚥 → Lightning bolt (general charging)

